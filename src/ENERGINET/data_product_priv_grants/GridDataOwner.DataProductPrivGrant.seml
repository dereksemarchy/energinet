_package: ENERGINET.data_product_priv_grants
_name: GridDataOwner
_type: DataProductPrivGrant
roleName: GridDataOwner
label: Grid data owner
description: 'Accountable for the data product: approves asset changes, full read/write access.'
dataAdminRole: true
entityPrivGrants:
- _type: EntityPrivGrant
  entity: ENERGINET.entities.Substation.Substation
  _name: Substation
  checkoutAllowed: true
  createAllowed: true
  deleteAllowed: true
  exportAllowed: true
  removeAllowed: true
  defaultAccessType: READ_WRITE
