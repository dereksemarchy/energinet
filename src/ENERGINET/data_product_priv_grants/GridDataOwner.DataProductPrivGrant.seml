  _name: Asset
  checkoutAllowed: true
  createAllowed: true
  deleteAllowed: true
  exportAllowed: true
  removeAllowed: true
  defaultAccessType: READ_WRITE
- _type: EntityPrivGrant
  entity: ENERGINET.entities.MeasurementPoint.MeasurementPoint
  _name: MeasurementPoint
  checkoutAllowed: true
  createAllowed: true
  deleteAllowed: true
  exportAllowed: true
  removeAllowed: true
  defaultAccessType: READ_WRITE
- _type: EntityPrivGrant
