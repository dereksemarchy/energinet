_package: ENERGINET.data_product_priv_grants
_name: GridDataSteward
_type: DataProductPrivGrant
roleName: GridDataSteward
label: Grid data steward
description: Maintains substations, assets, lines and measurement points; reviews duplicates; reads measurements.
entityPrivGrants:
- _type: EntityPrivGrant
  entity: ENERGINET.entities.Substation.Substation
  _name: Substation
  checkoutAllowed: true
  createAllowed: true
  deleteAllowed: true
  exportAllowed: true
  removeAllowed: true
  defaultAccessType: READ_WRITE
- _type: EntityPrivGrant
  entity: ENERGINET.entities.TransmissionLine.TransmissionLine
  _name: TransmissionLine
  checkoutAllowed: true
  createAllowed: true
  deleteAllowed: true
  exportAllowed: true
  removeAllowed: true
  defaultAccessType: READ_WRITE
- _type: EntityPrivGrant
  entity: ENERGINET.entities.Asset.Asset
  _name: Asset
  checkoutAllowed: true
  createAllowed: true
  deleteAllowed: true
  exportAllowed: true
  removeAllowed: true
  defaultAccessType: READ_WRITE
- _type: EntityPrivGrant
  entity: ENERGINET.entities.MeasurementPoint.MeasurementPoint
  _name: MeasurementPoint
  checkoutAllowed: true
  createAllowed: true
  deleteAllowed: true
  exportAllowed: true
  removeAllowed: true
  defaultAccessType: READ_WRITE
- _type: EntityPrivGrant
  entity: ENERGINET.entities.Measurement.Measurement
  _name: Measurement
  checkoutAllowed: true
  createAllowed: false
  deleteAllowed: false
  exportAllowed: true
  removeAllowed: false
  defaultAccessType: READ
