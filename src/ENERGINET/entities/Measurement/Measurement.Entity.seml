  _name: MeasurementId
  label: Measurement id
  physicalName: MEASUREMENTID
  dataType: LongInteger
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  searchable: true
  description: Identifier generated by the platform.
  documentation: Identifier generated by the platform.
  precision: 18
- _type: EntityAttribute
  _name: PeriodStart
  label: Period start
  physicalName: PERIODSTART
  dataType: Timestamp
  precision: 6
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  searchable: true
  description: Start of the aggregation window (UTC).
  documentation: Start of the aggregation window (UTC).
- _type: EntityAttribute
