_package: ENERGINET.entities.Asset.enrichers
_name: TrimAssetName
_type: SemQLEnricher
entity: ENERGINET.entities.Asset.Asset
label: Trim name
description: Removes leading and trailing spaces from AssetName.
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
- attributeName: AssetName
  expression: RTRIM(LTRIM(AssetName))
