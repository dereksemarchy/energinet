_package: ENERGINET.entities.Asset
_type: Entity
_name: Asset
label: Asset
pluralLabel: Assets
entityType: FUZZY_MATCHED
physicalTableName: ASSET
iconUrl: images://mdi/flash.svg
description: |-
  Grid equipment (transformer, breaker, disconnector, busbar, instrument transformer, reactor, capacitor bank, protection relay), consolidated from the network model and the asset register, which share no equipment key.

  AI agent instructions: Reason on golden records; master records are source contributions and are not distinct assets. NetworkModelId and EamAssetNumber trace the golden record back to each system.
documentation: |-
  Grid equipment (transformer, breaker, disconnector, busbar, instrument transformer, reactor, capacitor bank, protection relay), consolidated from the network model and the asset register, which share no equipment key.

  AI agent instructions: Reason on golden records; master records are source contributions and are not distinct assets. NetworkModelId and EamAssetNumber trace the golden record back to each system.
historizeGolden: true
historizeMaster: true
enableDelete: true
attributes:
- _type: EntityAttribute
  _name: AssetId
  label: Asset id
  physicalName: ASSETID
  dataType: LongInteger
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  searchable: true
  description: Identifier generated by the platform.
  documentation: Identifier generated by the platform.
  precision: 18
- _type: EntityAttribute
  _name: AssetName
  label: Asset name
  physicalName: ASSETNAME
  dataType: String
  length: 150
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  searchable: true
  description: Equipment designation.
  documentation: Equipment designation.
- _type: EntityAttribute
  _name: AssetType
  label: Asset type
  physicalName: ASSETTYPE
  dataType: ENERGINET.list_of_values.AssetType
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  lovValidationScope: PRE_CONSO
  searchable: true
  description: Kind of equipment.
  documentation: Kind of equipment.
- _type: EntityAttribute
  _name: NetworkModelId
  label: Network model id (mRID)
  physicalName: NETWORKMODELID
  dataType: String
  length: 64
  mandatory: false
  searchable: true
  description: CIM mRID of the equipment in the network model.
  documentation: CIM mRID of the equipment in the network model.
- _type: EntityAttribute
  _name: EamAssetNumber
  label: EAM asset number
  physicalName: EAMASSETNUMBER
  dataType: String
  length: 30
  mandatory: false
  searchable: true
  description: Equipment number in the asset register.
  documentation: Equipment number in the asset register.
- _type: EntityAttribute
  _name: Manufacturer
  label: Manufacturer
  physicalName: MANUFACTURER
  dataType: String
  length: 100
  mandatory: false
  searchable: true
  description: Original equipment manufacturer.
  documentation: Original equipment manufacturer.
- _type: EntityAttribute
  _name: Model
  label: Model
  physicalName: MODEL
  dataType: String
  length: 100
  mandatory: false
  searchable: true
  description: Manufacturer model reference.
  documentation: Manufacturer model reference.
- _type: EntityAttribute
  _name: SerialNumber
  label: Serial number
  physicalName: SERIALNUMBER
  dataType: String
  length: 50
  mandatory: false
  searchable: true
  description: Manufacturer serial number.
  documentation: Manufacturer serial number.
- _type: EntityAttribute
  _name: VoltageLevel
  label: Voltage level
  physicalName: VOLTAGELEVEL
  dataType: ENERGINET.list_of_values.VoltageLevel
  mandatory: false
  lovValidationScope: PRE_CONSO
  searchable: true
  description: Rated voltage level.
  documentation: Rated voltage level.
- _type: EntityAttribute
  _name: RatedPowerMva
  label: Rated power (MVA)
  physicalName: RATEDPOWERMVA
  dataType: Decimal
  precision: 10
  scale: 2
  mandatory: false
  searchable: true
  description: Rated apparent power in MVA (transformers, reactors).
  documentation: Rated apparent power in MVA (transformers, reactors).
- _type: EntityAttribute
  _name: CommissioningDate
  label: Commissioning date
  physicalName: COMMISSIONINGDATE
  dataType: Date
  mandatory: false
  searchable: true
  description: Date the asset was put into service.
  documentation: Date the asset was put into service.
- _type: EntityAttribute
  _name: OperatingStatus
  label: Operating status
  physicalName: OPERATINGSTATUS
  dataType: ENERGINET.list_of_values.OperatingStatus
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  lovValidationScope: PRE_CONSO
  searchable: true
  description: Operating status of the asset.
  documentation: Operating status of the asset.
- _type: EntityAttribute
  _name: Criticality
  label: Criticality
  physicalName: CRITICALITY
  dataType: ENERGINET.list_of_values.Criticality
  mandatory: false
  lovValidationScope: PRE_CONSO
  searchable: true
  description: Maintenance priority.
  documentation: Maintenance priority.
- _type: EntityAttribute
  _name: LastInspectionDate
  label: Last inspection date
  physicalName: LASTINSPECTIONDATE
  dataType: Date
  mandatory: false
  searchable: true
  description: Date of the last inspection (asset register).
  documentation: Date of the last inspection (asset register).
- _type: EntityAttribute
  _name: AgeYears
  label: Age (years)
  physicalName: AGEYEARS
  dataType: Integer
  precision: 4
  mandatory: false
  searchable: true
  description: |-
    Whole years since commissioning, computed when the record is certified.

    AI agent instructions: Computed at certification time, so it can lag up to a year until the record is next certified; recompute from CommissioningDate for exact ages.
  documentation: |-
    Whole years since commissioning, computed when the record is certified.

    AI agent instructions: Computed at certification time, so it can lag up to a year until the record is next certified; recompute from CommissioningDate for exact ages.
- _type: EntityAttribute
  _name: NormalizedName
  label: Normalized name
  physicalName: NORMALIZEDNAME
  dataType: String
  length: 150
  mandatory: false
  searchable: true
  description: |-
    Upper-case name without punctuation or spaces, used to match the two sources.

    AI agent instructions: Technical matching key: never display it or reason on it; use AssetName.
  documentation: |-
    Upper-case name without punctuation or spaces, used to match the two sources.

    AI agent instructions: Technical matching key: never display it or reason on it; use AssetName.
primaryKey: ENERGINET.entities.Asset.Asset.AssetId
sourceIdGeneration:
  mode: MANUAL
  startWith: 1
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
matcher:
  _type: SemQLMatcher
  _name: AssetMatcher
  description: Matching strategy for Assets.
  matchRules:
  - _type: SemQLMatchRule
    _name: SerialAndManufacturer
    label: Same serial number and manufacturer
    color: md:green 800
    condition: Record1.SerialNumber IS NOT NULL AND Record1.Manufacturer IS NOT NULL AND UPPER(Record1.SerialNumber) = UPPER(Record2.SerialNumber) AND UPPER(Record1.Manufacturer) = UPPER(Record2.Manufacturer)
    matchScore: 100
    description: 'Same manufacturer serial number from the same manufacturer: the same physical equipment. Merged automatically.'
    documentation: 'Same manufacturer serial number from the same manufacturer: the same physical equipment. Merged automatically.'
    binningExpressions:
    - expression: UPPER(SerialNumber)
  - _type: SemQLMatchRule
    _name: SameBayNameClose
    label: Same substation and type, similar name
    color: md:amber 700
    condition: Record1.FID_Substation = Record2.FID_Substation AND Record1.AssetType = Record2.AssetType AND SEM_EDIT_DISTANCE_SIMILARITY(Record1.NormalizedName, Record2.NormalizedName) >= 85
    matchScore: 80
    description: 'Same substation, same equipment type and a close name: suggested to the data steward, never merged automatically.'
    documentation: 'Same substation, same equipment type and a close name: suggested to the data steward, never merged automatically.'
    binningExpressions:
    - expression: FID_Substation
    - expression: AssetType
  useTransitiveMatchScore: true
  useMultiIterationGrouping: true
  mergeThresholdNewGroup: 90
  mergeThresholdMergingUnconfirmed: 90
  mergeThresholdMergingConfirmed: 90
  mergeThresholdMergingConfirmedWithUnconfirmed: 90
  mergeThresholdMergingUnconfirmedWithNewMasters: 90
  mergeThresholdMergingConfirmedWithNewMasters: 90
  mergeThresholdRemergingPreviouslySplit: 100
  autoConfirmGoldenThreshold: 100
  autoConfirmSingletons: false
