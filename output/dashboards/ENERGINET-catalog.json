  "complexTypes": {},
  "validations": [
    {
      "name": "SourceIdentifier",
      "type": "SemQLValidation",
      "entity": "Asset",
      "label": "Source identifier required",
      "scope": "PRE_CONSO",
      "condition": "NetworkModelId IS NOT NULL OR EamAssetNumber IS NOT NULL",
      "message": "An asset needs a network model id (mRID) or an EAM asset number."
    },
    {
      "name": "ValueRange",
      "type": "SemQLValidation",
      "entity": "Measurement",
      "label": "Consistent value range",
      "scope": "PRE_CONSO",
      "condition": "(MinValue IS NULL OR MinValue <= AvgValue) AND (MaxValue IS NULL OR AvgValue <= MaxValue)",
      "message": "Minimum <= average <= maximum must hold."
    },
    {
      "name": "AlarmLimitsOrdered",
      "type": "SemQLValidation",
      "entity": "MeasurementPoint",
      "label": "Alarm limits ordered",
      "scope": "PRE_CONSO",
      "condition": "AlarmLowLimit IS NULL OR AlarmHighLimit IS NULL OR AlarmLowLimit < AlarmHighLimit",
      "message": "The alarm low limit must be lower than the high limit."
    },
    {
      "name": "DistinctEndpoints",
      "type": "SemQLValidation",
      "entity": "TransmissionLine",
      "label": "Distinct endpoints",
      "scope": "PRE_CONSO",
      "condition": "FID_FromSubstation IS NULL OR FID_ToSubstation IS NULL OR FID_FromSubstation <> FID_ToSubstation",
      "message": "A line must connect two different substations."
    },
    {
      "name": "PositiveLength",
      "type": "SemQLValidation",
      "entity": "TransmissionLine",
      "label": "Positive length",
      "scope": "PRE_CONSO",
      "condition": "LengthKm IS NULL OR LengthKm > 0",
      "message": "The line length must be greater than zero."
    }
  ],
