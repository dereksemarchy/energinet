_package: ENERGINET.entities.Asset.collection_views
_type: CollectionView
_name: AssetReviewCollectionView
entity: ENERGINET.entities.Asset.Asset
default: false
displayCard: ENERGINET.entities.Asset.display_cards.AssetDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: '1:1'
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Asset
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
- _type: IdColumn
  _name: GoldenId
  label: Record id
  value: AssetId
  useCustomLabel: true
  dataType: INTEGER
  columnAlign: LEFT
  visibleByDefault: true
- _type: ReferenceColumn
  _name: Substation
  value: FDN_Substation
  useCustomLabel: false
  dataType: STRING
  columnAlign: LEFT
  visibleByDefault: true
  referencedEntity: ENERGINET.entities.Substation.Substation
  componentProperties:
    cellBackgroundColor: CASE WHEN FID_Substation = GoldenRecord.FID_Substation OR COALESCE(FID_Substation, GoldenRecord.FID_Substation) IS NULL THEN NULL ELSE 'md:pink 50' END
    cellBackgroundColorValueInterpreter: SEMQL
- _type: TextColumn
  _name: AssetName
  value: AssetName
  useCustomLabel: false
  dataType: STRING
  columnAlign: LEFT
  visibleByDefault: true
  componentProperties:
